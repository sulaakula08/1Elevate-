# Copy to .env.local and fill in. .env.local is git-ignored and must stay that way.
#
# Supabase — Project Settings → API.
# The two NEXT_PUBLIC_ values are sent to the browser on purpose; they grant
# nothing on their own, because row-level security still applies to whoever the
# access token says you are.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses every row-level policy. Server-side only — never prefix it with
# NEXT_PUBLIC_, never import it from a "use client" file. Leave it empty unless
# something actually needs it; nothing in the app does today.
SUPABASE_SERVICE_ROLE_KEY=

# The AI tutor and the question generator. Without it those two features return
# a clear message and everything else works as usual.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5
